<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Name="Root" Title="ReShade Injector"
        Width="940" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.Resources>

    <SolidColorBrush x:Key="TextPrimary"   Color="#FFEDF0F6"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF9AA5B8"/>
    <SolidColorBrush x:Key="TextMuted"     Color="#FF838FA3"/>
    <SolidColorBrush x:Key="Accent"        Color="#FF5AC8FA"/>
    <SolidColorBrush x:Key="AccentDeep"    Color="#FF4A7DFF"/>
    <SolidColorBrush x:Key="CardBorder"    Color="#FF242B37"/>
    <SolidColorBrush x:Key="FieldBg"       Color="#FF0C0F15"/>
    <SolidColorBrush x:Key="OkColor"       Color="#FF3DD68C"/>
    <SolidColorBrush x:Key="WarnColor"     Color="#FFF0A53E"/>
    <SolidColorBrush x:Key="ErrColor"      Color="#FFEF5350"/>

    <!-- 主按钮渐变：浅青蓝 → 蓝。深色底上用冷色显得干净，也不抢内容 -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FF6FD6FB" Offset="0"/>
      <GradientStop Color="#FF4A7DFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- 卡片 -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#FF151920"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,14,16,16"/>
    </Style>

    <!-- 页面大标题 -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 页面副标题 -->
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>

    <!-- 卡片小标题 -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 次要说明文字 -->
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>

    <!-- 设置项名称 -->
    <Style x:Key="SettingLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFC3CCDC"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 幽灵按钮（描边） -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="#FFC3CCDC"/>
      <Setter Property="Background" Value="#12FFFFFF"/>
      <Setter Property="BorderBrush" Value="#FF2A3241"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Name="B" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#FF212936"/>
                <Setter TargetName="B" Property="BorderBrush" Value="#FF3A4456"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#FF171E28"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 注入主按钮：扁长的横条，不是立起来的方块。
         宽度由外部 Grid 列决定（Stretch），这样窗口拉宽它也跟着变宽。 -->
    <Style x:Key="InjectButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Name="B" CornerRadius="9" Background="{StaticResource AccentGradient}">
                <Border.Effect>
                  <DropShadowEffect Color="#FF4A7DFF" BlurRadius="16" ShadowDepth="2" Opacity="0.45"/>
                </Border.Effect>
              </Border>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Opacity" Value="0.92"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Opacity" Value="0.8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Opacity" Value="0.35"/>
                <Setter TargetName="B" Property="Effect" Value="{x:Null}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 取消等待的 × 按钮：点完「开始注入」后从主按钮右侧分裂出来的那一小块。
         平时 Collapsed，等待进程时才出现。悬停变红，语义明确。 -->
    <Style x:Key="CancelButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#FFB8C4D6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Name="B" CornerRadius="9" Background="#FF22303F"
                    BorderBrush="#FF35455A" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#FFE05555"/>
                <Setter TargetName="B" Property="BorderBrush" Value="#FFFF7B7B"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#FFC94444"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 标题栏小按钮 -->
    <Style x:Key="TitleButton" TargetType="Button">
      <Setter Property="Foreground" Value="#FF8A94A8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Name="B" Background="{TemplateBinding Background}" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#1AFFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#10FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 左侧导航项：房子 / 齿轮。用 RadioButton 让选中态由 GroupName 天然互斥 -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#FF98A3B5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border Name="Bg" CornerRadius="11" Background="Transparent"/>
              <!-- 选中指示条：贴在导航栏左边缘 -->
              <Border Name="Bar" Width="3" Height="18" CornerRadius="2"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="-9,0,0,0" Background="{StaticResource Accent}"
                      Visibility="Collapsed"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#10FFFFFF"/>
                <Setter Property="Foreground" Value="#FFC6D0E0"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 单行输入框 -->
    <Style x:Key="DarkTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource FieldBg}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="BorderBrush" Value="#FF262E3C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="SelectionBrush" Value="#FF2F5DA8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="8" x:Name="B">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#FF4C8DFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 多行日志框 -->
    <Style x:Key="LogBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource FieldBg}"/>
      <Setter Property="Foreground" Value="#FFC6D0E0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="AcceptsReturn" Value="True"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 进程列表 -->
    <Style x:Key="PlainList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <!-- 条目内容：颜色由 ProcessItem.DisplayBrush 直接给，避免触发器优先级问题 -->
      <Setter Property="ItemTemplate">
        <Setter.Value>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Display}"
                         Foreground="{Binding DisplayBrush}"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="1" Text="{Binding Status}"
                         Foreground="{Binding StatusBrush}"
                         FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border Name="B" Background="Transparent" CornerRadius="7"
                          Padding="9,6" Margin="0,1">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="B" Property="Background" Value="#10FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="B" Property="Background" Value="#1F4C8DFF"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 复选框 -->
    <Style x:Key="DarkCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#FFC6D0E0"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border Name="Box" Width="16" Height="16" CornerRadius="5"
                      Background="#FF0C0F15" BorderBrush="#FF333D4E" BorderThickness="1"
                      VerticalAlignment="Center">
                <Path Name="Tick" Data="M 2,6 L 5,9 L 10,3" Stroke="White" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentDeep}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Tick" Property="Stroke" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  <!-- ================= 滚动条：细窄胶囊、无上下箭头 ================= -->

    <!-- 轨道两端的翻页按钮：完全透明，默认那对灰色小箭头就此消失 -->
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 垂直滑块：圆角胶囊，平时很暗、鼠标移上去变亮、拖动时用主题蓝 -->
    <Style x:Key="ScrollThumbVertical" TargetType="Thumb">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Name="Bd" CornerRadius="3" Margin="2,2" Background="#FF2B3340"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF414D61"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDeep}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 水平滑块：同上，只是留白方向换一下 -->
    <Style x:Key="ScrollThumbHorizontal" TargetType="Thumb">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Name="Bd" CornerRadius="3" Margin="2,2" Background="#FF2B3340"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF414D61"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDeep}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 滚动条本体：9px 宽，轨道透明，只有滑块可见 -->
    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical">
          <Setter Property="Width" Value="9"/>
          <Setter Property="MinWidth" Value="9"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <!-- 竖直方向从下往上增长，所以 IsDirectionReversed 为 True -->
                  <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPageButton}"
                                    Command="ScrollBar.PageUpCommand"
                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumbVertical}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPageButton}"
                                    Command="ScrollBar.PageDownCommand"
                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="9"/>
          <Setter Property="MinHeight" Value="9"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPageButton}"
                                    Command="ScrollBar.PageLeftCommand"
                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumbHorizontal}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPageButton}"
                                    Command="ScrollBar.PageRightCommand"
                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- 隐式样式：窗口内所有滚动条（设置页、进程列表、日志框）统一换成上面这条 -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>

    <!-- ===== 右键菜单：深色，别用系统那套白底方角菜单 ===== -->
    <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
      <Setter Property="Background" Value="#FF14181F"/>
      <Setter Property="BorderBrush" Value="#FF2C3545"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <!-- 注意：这里绝对不能放 Popup。
                 ContextMenu 在打开时会自己 new 一个 Popup 并把自身塞进去，
                 定位（鼠标点在哪就显示在哪）由 WPF 内部的 CustomPopupPlacement 回调算。
                 模板里再套一层 Popup 就成了双层弹窗，内层拿不到坐标，
                 菜单会跑到屏幕左上角去。 -->
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DarkMenuItem" TargetType="MenuItem">
      <Setter Property="Foreground" Value="#FFD5DCE8"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Bd" CornerRadius="7" Background="Transparent"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                RecognizesAccessKey="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF22303F"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#FF5C6678"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DarkMenuSeparator" TargetType="Separator">
      <Setter Property="Margin" Value="6,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Background="#FF242B37"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <!-- 外层壳：不加任何阴影（分层窗口上做 Effect 会出白边），就是干净的圆角面板 -->
  <Border Margin="0" CornerRadius="14" BorderBrush="#FF2C3545" BorderThickness="1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
          <GradientStop Color="#FF11141B" Offset="0"/>
          <GradientStop Color="#FF0C0E14" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="50"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ================= 标题栏 ================= -->
      <Grid Name="TitleBar" Grid.Row="0" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8" Margin="16,0,0,0"
                VerticalAlignment="Center">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF6FD6FB" Offset="0"/>
              <GradientStop Color="#FF4A7DFF" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Path Data="M 7,4 L 7,14 M 7,4 L 13,9 L 7,14" Stroke="White" StrokeThickness="1.7"
                StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
        </Border>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock Text="ReShade" Foreground="{StaticResource TextPrimary}"
                     FontSize="13.5" FontWeight="SemiBold"/>
          <TextBlock Text="Injector" Foreground="{StaticResource TextMuted}"
                     FontSize="13.5" Margin="5,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button Name="MinButton" Style="{StaticResource TitleButton}" ToolTip="最小化">
            <Path Data="M 0,0 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.4"/>
          </Button>
          <Button Name="CloseButton" Style="{StaticResource TitleButton}" ToolTip="关闭" Margin="2,0,0,0">
            <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.4"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- ================= 主体：左导航 + 右内容 ================= -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="58"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧竖条：上=主界面 + 预设，下=设置 -->
        <Border Grid.Column="0" BorderBrush="#FF1A202B" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <RadioButton Name="NavHomeButton" Grid.Row="0" GroupName="NavPage"
                         Style="{StaticResource NavItem}" IsChecked="True"
                         Margin="9,8,9,0" ToolTip="主界面">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="18"/>
            </RadioButton>

            <RadioButton Name="NavPresetsButton" Grid.Row="1" GroupName="NavPage"
                         Style="{StaticResource NavItem}"
                         Margin="9,0,9,0" ToolTip="预设">
              <!-- 一大一小两个四角星（sparkle），用 Path 画、不吃字体图标。
                   两条 Path 共用同一段几何数据，靠 Width/Height + Stretch 缩放。
                   Fill 绑到 NavItem 的 Foreground，选中时才跟着变强调色。 -->
              <Viewbox Width="23" Height="23">
                <Canvas Width="24" Height="24">
                  <Path Canvas.Left="0" Canvas.Top="0" Width="18" Height="18"
                        Stretch="Uniform" Fill="Transparent"
                        StrokeThickness="1.9" StrokeLineJoin="Round"
                        Data="M12,1 Q13.9,10.1 23,12 Q13.9,13.9 12,23 Q10.1,13.9 1,12 Q10.1,10.1 12,1 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"/>
                  <Path Canvas.Left="13" Canvas.Top="13" Width="11" Height="11"
                        Stretch="Uniform" Fill="Transparent"
                        StrokeThickness="1.35" StrokeLineJoin="Round"
                        Data="M12,1 Q13.9,10.1 23,12 Q13.9,13.9 12,23 Q10.1,13.9 1,12 Q10.1,10.1 12,1 Z"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"/>
                </Canvas>
              </Viewbox>
            </RadioButton>

            <RadioButton Name="NavSettingsButton" Grid.Row="3" GroupName="NavPage"
                         Style="{StaticResource NavItem}"
                         Margin="9,0,9,10" ToolTip="设置">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="18"/>
            </RadioButton>
          </Grid>
        </Border>

        <!-- 右侧内容：两页叠放，靠 Visibility 切换 -->
        <Grid Grid.Column="1">

          <!-- ============ 主界面 ============ -->
          <Grid Name="PageHome">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 上半：两列 —— 左边选游戏，右边 DLL + 日志 -->
            <Grid Grid.Row="0" Margin="16,6,16,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- 目标进程 -->
              <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <Grid Grid.Row="0">
                    <TextBlock Text="目标进程" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                    <Button Name="RefreshButton" Style="{StaticResource GhostButton}"
                            Content="刷新" HorizontalAlignment="Right" Height="24" Padding="9,0" FontSize="11"/>
                  </Grid>

                  <ListBox Name="ProcessList" Grid.Row="1" Style="{StaticResource PlainList}"
                           Margin="0,8,0,0"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                  <TextBox Name="ManualProcess" Grid.Row="2" Style="{StaticResource DarkTextBox}"
                           Margin="0,8,0,0" Height="32"/>

                  <TextBlock Grid.Row="3" Style="{StaticResource Hint}" Margin="0,6,0,0"
                             Text="未运行也能选，配合「等待进程启动」；也可手输任意进程名。"/>
                </Grid>
              </Border>

              <!-- 右列：DLL + 日志 -->
              <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 注入模块 -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="注入模块（DLL）" Style="{StaticResource CardTitle}"/>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBox Name="DllPath" Style="{StaticResource DarkTextBox}" Grid.Column="0" Height="32"/>
                      <Button Name="BrowseButton" Style="{StaticResource GhostButton}" Grid.Column="1"
                              Content="浏览…" Height="32" Margin="8,0,0,0" Padding="12,0"/>
                    </Grid>
                    <TextBlock Name="DllStatus" Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="请选择要注入的 DLL"/>
                  </StackPanel>
                </Border>

                <!-- 日志 -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                      <TextBlock Text="运行日志" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                      <Button Name="ClearButton" Style="{StaticResource GhostButton}"
                              Content="清空" HorizontalAlignment="Right" Height="24" Padding="9,0" FontSize="11"/>
                    </Grid>

                    <TextBox Name="Log" Grid.Row="1" Style="{StaticResource LogBox}" Margin="0,8,0,0"/>
                  </Grid>
                </Border>
              </Grid>
            </Grid>

            <!-- 底部固定条：左状态，右注入按钮 -->
            <Border Grid.Row="1" Margin="16,10,16,14" Padding="14,10"
                    Background="#FF151920" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Name="StatusDot" Width="7" Height="7" Fill="#FF3DD68C" VerticalAlignment="Center"/>
                    <TextBlock Name="StatusText" Text="就绪" Foreground="{StaticResource TextSecondary}"
                               FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Name="PrivilegeText" Text="" Foreground="{StaticResource TextMuted}"
                             FontSize="11" Margin="14,4,0,0" Cursor="Hand" Background="Transparent"/>
                </StackPanel>

                <CheckBox Name="WaitCheck" Grid.Column="1" Style="{StaticResource DarkCheck}"
                          Content="等待进程启动" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,18,0"/>

                <Grid Grid.Column="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <Button Name="InjectButton" Grid.Column="0" Style="{StaticResource InjectButtonStyle}"
                          Content="开始注入"/>

                  <!-- 等待进程时从主按钮右侧分裂出来，点它取消等待 -->
                  <Button Name="CancelButton" Grid.Column="1" Style="{StaticResource CancelButtonStyle}"
                          Visibility="Collapsed" Margin="6,0,0,0" ToolTip="取消等待注入"
                          Content="&#xE711;" FontFamily="Segoe MDL2 Assets"/>
                </Grid>
              </Grid>
            </Border>
          </Grid>

          <!-- ============ 预设页 ============ -->
          <Grid Name="PagePresets" Visibility="Collapsed">
            <Grid Margin="16,8,16,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- 左：当前游戏的预设列表 -->
              <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>

                  <Grid Grid.Row="0">
                    <TextBlock Text="预设" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                    <Button Name="RefreshPresetButton" Style="{StaticResource GhostButton}"
                            Content="刷新" HorizontalAlignment="Right" Height="24" Padding="9,0" FontSize="11"/>
                  </Grid>

                  <TextBlock Name="PresetGameText" Grid.Row="1" Style="{StaticResource Hint}"
                             Margin="0,6,0,0" TextWrapping="Wrap" Text=""/>

                  <ListBox Name="PresetList" Grid.Row="2" Style="{StaticResource PlainList}"
                           Margin="0,8,0,0"/>
                </Grid>
              </Border>

              <!-- 右：新建 / 导入 / 应用 -->
              <StackPanel Grid.Column="1" Margin="12,0,0,0">

                <!-- 新建空预设 -->
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="新建预设" Style="{StaticResource CardTitle}"/>

                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBox Name="NewPresetInput" Grid.Column="0" Style="{StaticResource DarkTextBox}"
                               Height="32" Text="" ToolTip="给新预设起个名字"/>
                      <Button Name="CreatePresetButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                              Content="创建" Height="32" Padding="14,0" Margin="8,0,0,0"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="会在 Shader\&lt;当前游戏&gt;\ 下建一个同名文件夹，里面是空的 Shaders 与 Textures。"/>
                  </StackPanel>
                </Border>

                <!-- 导入 -->
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                  <StackPanel>
                    <TextBlock Text="导入滤镜包" Style="{StaticResource CardTitle}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                      <Button Name="ImportFolderButton" Style="{StaticResource GhostButton}"
                              Content="选择文件夹…" Height="32" Padding="14,0"/>
                      <Button Name="ImportZipButton" Style="{StaticResource GhostButton}"
                              Content="选择压缩包…" Height="32" Padding="14,0" Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="压缩包或文件夹里只要能找到 Shaders 与 Textures（可以直接是 reshade-shaders 那种嵌套），就会自动认出来并复制成新预设。导入时会先问预设名称。"/>
                  </StackPanel>
                </Border>

                <!-- 应用 / 删除 -->
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                  <StackPanel>
                    <TextBlock Text="应用" Style="{StaticResource CardTitle}"/>

                    <TextBlock Name="PresetCurrentText" Style="{StaticResource Hint}" Margin="0,10,0,0"
                               TextWrapping="Wrap" Text=""/>

                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Button Name="ApplyPresetButton" Grid.Column="0" Style="{StaticResource InjectButtonStyle}"
                              Height="36" Content="应用选中的预设"/>
                      <Button Name="DeletePresetButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                              Content="删除" Height="36" Padding="14,0" Margin="8,0,0,0"
                              Foreground="{StaticResource ErrColor}"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="应用会把选中预设的 Shaders / Textures 路径写进该游戏目录下的 ReShade.ini 的 EffectSearchPaths / TextureSearchPaths。不用退出游戏 —— 在游戏里按 Home 呼出 ReShade 覆盖层，点一下「重新加载」，立刻生效。"/>
                  </StackPanel>
                </Border>

              </StackPanel>
            </Grid>
          </Grid>

          <!-- ============ 设置页 ============ -->
          <Grid Name="PageSettings" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="16,8,16,14">
              <StackPanel>

                <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="配置类的东西放这里，主界面只管注入。"/>

                <!-- 等待与超时 -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="等待进程启动" Style="{StaticResource CardTitle}"/>

                    <Grid Margin="0,12,0,0">
                      <TextBlock Text="超时时间" Style="{StaticResource SettingLabel}"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBox Name="TimeoutInput" Style="{StaticResource DarkTextBox}"
                                 Width="72" Text="120" HorizontalContentAlignment="Center" Height="32"
                                 FontFamily="Cascadia Mono, Consolas"/>
                        <TextBlock Text="秒" Foreground="{StaticResource TextSecondary}"
                                   FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                      </StackPanel>
                    </Grid>

                    <TextBlock Name="TimeoutText" Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="当前生效：120 秒（可选 10 ~ 3600）"/>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="游戏还没运行时，注入器会一直轮询等它出现再注入。米哈游的启动器从点「开始游戏」到进程真正起来有几秒延迟，所以建议先点注入、再用启动器拉起游戏。"/>
                  </StackPanel>
                </Border>

                <!-- 程序目录 -->
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                  <StackPanel>
                    <TextBlock Text="程序目录" Style="{StaticResource CardTitle}"/>

                    <TextBlock Name="AppDirText" Foreground="{StaticResource TextPrimary}"
                               FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                               Margin="0,12,0,0" TextWrapping="Wrap" Text=""/>
                    <Button Name="OpenAppDirButton" Style="{StaticResource GhostButton}"
                            Content="打开文件夹" HorizontalAlignment="Left" Margin="0,12,0,0"/>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="DLL 放在程序目录下的 DLL\ 里会自动选中；滤镜包（Shader\Default\Shaders、Shader\Default\Textures、Addons）和字体（Fonts\）放在程序目录下，注入时会自动把这些路径写进游戏目录的 ReShade.ini。"/>
                  </StackPanel>
                </Border>

                <!-- 关于 -->
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                  <StackPanel>
                    <TextBlock Text="关于" Style="{StaticResource CardTitle}"/>

                    <Grid Margin="0,12,0,0">
                      <TextBlock Text="版本" Style="{StaticResource SettingLabel}"/>
                      <TextBlock Name="VersionText" Text="1.0.0" Foreground="{StaticResource TextSecondary}"
                                 FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 FontFamily="Cascadia Mono, Consolas"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="注入方式为远程线程 + LoadLibraryW（与 ReShade 官方装法一致）。目标游戏目录会自动识别（运行中的进程 → HoYoPlay 注册表 → 上次手动指定），识别不到才让你手选 exe，选一次就记住。"/>
                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>
          </Grid>

        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>